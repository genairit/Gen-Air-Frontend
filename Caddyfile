{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip
	root * /srv

	handle_path /api/* {
		reverse_proxy {$BACKEND_URL}
	}

	handle /assets/* {
		@existingAsset file
		header @existingAsset Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
